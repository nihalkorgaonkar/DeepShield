# DeepShield Environment Configuration Example
# Copy to .env or configure in your environment

# Backend API Configuration
DEEPSHIELD_HOST=127.0.0.1
DEEPSHIELD_PORT=8000

# Frontend Next.js API Proxy Target
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# GPU Configuration (Leave empty or 0 for primary NVIDIA GPU, or set to "" to force CPU)
CUDA_VISIBLE_DEVICES=0

# Dataset Paths (Defaults match local research setup)
DEEPSHIELD_DATA_ROOT=C:\DeepShieldData\ASVspoof2019_LA
DEEPSHIELD_CACHE_ROOT=C:\DeepShieldData\cache_spec\128x128
DEEPSHIELD_DF2021_ROOT=C:\DeepShieldData\ASVspoof2021_DF

# Environment and secrets
.env
.env.*
!.env.example

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Frontend dependencies and builds
node_modules/
.next/
dist/
build/
.expo/

# Temporary files and logs
tmp/
*.log

# Generated results and reports
outputs/
results/
reports/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db